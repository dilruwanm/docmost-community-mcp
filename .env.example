# Base URL of your self-hosted Docmost instance (no trailing /api required)
DOCMOST_URL=https://docs.example.com

# Community Edition auth — email/password login, session cached locally
DOCMOST_EMAIL=you@example.com
DOCMOST_PASSWORD=your-password

# Optional: reuse a browser authToken cookie instead of email/password
# DOCMOST_AUTH_TOKEN=

# Optional: override session cache path (default ~/.docmost-community-mcp/session.json)
# DOCMOST_SESSION_PATH=

# Optional: refuse create/update/move/delete (search and read still work)
# DOCMOST_READ_ONLY=true
